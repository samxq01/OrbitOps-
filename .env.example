# ==============================================================================
# OrbitOps Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env or .env.local for local overrides.
# Never commit actual credentials or secrets to version control.

# Backend Configuration
ORBITOPS_ENV=development
ORBITOPS_DEBUG=true
ORBITOPS_API_HOST=127.0.0.1
ORBITOPS_API_PORT=8000
ORBITOPS_APP_NAME="OrbitOps Mission Control API"
ORBITOPS_APP_VERSION="0.1.0"
ORBITOPS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ORBITOPS_DATABASE_URL=sqlite:///./orbitops.sqlite3
ORBITOPS_SIMULATION_MODE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME="OrbitOps"
NEXT_PUBLIC_SIMULATION_MODE=true
